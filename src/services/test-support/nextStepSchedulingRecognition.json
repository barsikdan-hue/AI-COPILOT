[
  {
    "sessionId": "session_1790943069981_gjy4",
    "sourceFile": "call_record_2026-10-02_sessio (9).json",
    "sourceSha256": "107521E261C181D81BD3C265E99B6FD65D3BBCEF8AA37277102CB6E276B6AC4C",
    "turns": [
      {
        "id": "turn_1790943079986_xxyw",
        "sessionId": "session_1790943069981_gjy4",
        "source": "microphone",
        "speaker": "agent",
        "text": "просьба, давайте мы",
        "timestamp": 1790943079980,
        "isFinal": true,
        "revision": 1
      },
      {
        "id": "turn_1790943085453_iae9",
        "sessionId": "session_1790943069981_gjy4",
        "source": "microphone",
        "speaker": "agent",
        "text": "Добрый день, меня зовут Данил, специалист по недвижимости компании Элитный Сочи.",
        "timestamp": 1790943085449,
        "isFinal": true,
        "revision": 2
      },
      {
        "id": "turn_1790943090227_6w7a",
        "sessionId": "session_1790943069981_gjy4",
        "source": "microphone",
        "speaker": "agent",
        "text": "Как я могу к вам обращаться?",
        "timestamp": 1790943090210,
        "isFinal": true,
        "revision": 3
      },
      {
        "id": "turn_1790943095789_12ij",
        "sessionId": "session_1790943069981_gjy4",
        "source": "call_audio",
        "speaker": "client",
        "text": "Сергей, только сразу скажу, не надо сейчас расспрашивать, времени нет.",
        "timestamp": 1790943095783,
        "isFinal": true,
        "revision": 4
      },
      {
        "id": "turn_1790943103577_hm5c",
        "sessionId": "session_1790943069981_gjy4",
        "source": "microphone",
        "speaker": "agent",
        "text": "На каком вы сейчас этапе: присматриваете или уже ездите смотреть конкретные объекты?",
        "timestamp": 1790943103574,
        "isFinal": true,
        "revision": 5
      },
      {
        "id": "turn_1790943110042_yi98",
        "sessionId": "session_1790943069981_gjy4",
        "source": "call_audio",
        "speaker": "client",
        "text": "Слушайте, без анкет, ладно? Если коротко, присматриваюсь пока, ничего не выбрал.",
        "timestamp": 1790943110041,
        "isFinal": true,
        "revision": 6
      },
      {
        "id": "turn_1790943116820_ukt7",
        "sessionId": "session_1790943069981_gjy4",
        "source": "microphone",
        "speaker": "agent",
        "text": "Понял, не отвлекаю. Когда конкретно вернемся к разговору, сегодня вечером или завтра?",
        "timestamp": 1790943116819,
        "isFinal": true,
        "revision": 7
      },
      {
        "id": "turn_1790943119573_s5ci",
        "sessionId": "session_1790943069981_gjy4",
        "source": "call_audio",
        "speaker": "client",
        "text": "Завтра в 14:05.",
        "timestamp": 1790943119571,
        "isFinal": true,
        "revision": 8
      },
      {
        "id": "turn_1790943127804_j3hw",
        "sessionId": "session_1790943069981_gjy4",
        "source": "microphone",
        "speaker": "agent",
        "text": "Я не буду растягивать разговор, зафиксирую сказанное и вернемся к одному следующему шагу. Когда вам будет удобно?",
        "timestamp": 1790943127802,
        "isFinal": true,
        "revision": 9
      },
      {
        "id": "turn_1790943132508_uyje",
        "sessionId": "session_1790943069981_gjy4",
        "source": "call_audio",
        "speaker": "client",
        "text": "Завтра во второй половине дня, но без растягиваний.",
        "timestamp": 1790943132506,
        "isFinal": true,
        "revision": 10
      },
      {
        "id": "turn_1790943139233_de57",
        "sessionId": "session_1790943069981_gjy4",
        "source": "microphone",
        "speaker": "agent",
        "text": "Зафиксируй встречу точно. Уточни время, какой вариант удобен.",
        "timestamp": 1790943139222,
        "isFinal": true,
        "revision": 11
      },
      {
        "id": "turn_1790943144405_0jbj",
        "sessionId": "session_1790943069981_gjy4",
        "source": "call_audio",
        "speaker": "client",
        "text": "После обеда ближе к трем, если коротко и по делу.",
        "timestamp": 1790943144400,
        "isFinal": true,
        "revision": 12
      },
      {
        "id": "turn_1790943151838_5f51",
        "sessionId": "session_1790943069981_gjy4",
        "source": "microphone",
        "speaker": "agent",
        "text": "Более того, когда вы будете рассматривать недвижимость для жизни, отдыха или инвестиций.",
        "timestamp": 1790943151836,
        "isFinal": true,
        "revision": 13
      },
      {
        "id": "turn_1790943157220_1b7v",
        "sessionId": "session_1790943069981_gjy4",
        "source": "call_audio",
        "speaker": "client",
        "text": "Вот это как раз потом, завтра коротко скажу, сейчас не готов это обсуждать.",
        "timestamp": 1790943157217,
        "isFinal": true,
        "revision": 14
      }
    ],
