    "unit": "One atomic question per item, using only the full ordered turns included in that item.",
    "input_format": "input and speaker are the last turn; context contains preceding turns; turns is the canonical complete ordered dialogue. Do not evaluate input alone when context is nonempty.",
    "labels": {
      "YES": "The requested proposition is explicitly supported by the text and allowed ordered context.",
      "NO": "The proposition is explicitly denied, or an explicit correction gives an incompatible value for the same owner, time and field.",
      "UNKNOWN": "The supplied text does not determine YES or NO: omission, question, hypothetical condition or explicit uncertainty. This is an epistemic annotation, not a new product state."
