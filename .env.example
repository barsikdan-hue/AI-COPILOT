# GEMINI_API_KEY is a SERVER-SIDE runtime secret.
# Required for live Gemini transcription / semantic analysis; optional in local deterministic mode.
# Put the real key in a local uncommitted .env file or OS/server secret storage.
# Never expose it through VITE_* variables or frontend code.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# auto | local | gemini
# auto: local deterministic hint first + Gemini runtime enhancement when available.
# local: no Gemini analysis dependency (useful for offline logic testing).
COPILOT_ANALYSIS_MODE="auto"

# Optional public base URL for deployed server integrations/callbacks.
APP_URL="MY_APP_URL"
