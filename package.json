{
  "name": "ai-copilot-realtor",
  "private": true,
  "version": "4.0.2-rc.5.4",
  "type": "module",
  "scripts": {
    "dev": "tsx server-entry.ts",
    "dev:local": "COPILOT_ANALYSIS_MODE=local tsx server-entry.ts",
    "build": "vite build && esbuild server-entry.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "start:local": "COPILOT_ANALYSIS_MODE=local node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:rc5": "vitest run src/services/session5SemanticRegression.test.ts src/services/suggestionLiveness.test.ts src/services/rc4StressRegression.test.ts src/services/session11Regression.test.ts src/services/rc53AuditRegression.test.ts src/services/session12Regression.test.ts",
    "verify": "npm test && npm run lint && npm run build"
  },
  "dependencies": {
    "@google/genai": "2.24.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
